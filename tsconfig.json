{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "lib": [
      "es2019",
      "es2020.bigint",
      "es2020.date",
      "es2020.number",
      "es2020.promise",
      "es2020.string",
      "es2020.symbol.wellknown",
      "es2021.promise",
      "es2021.string",
      "es2021.weakref",
      "es2022.array",
      "es2022.object",
      "es2022.string",
      "dom",
      "dom.iterable"
    ],
    "typeRoots": ["./node_modules/@types", "./src/@types"],
    "types": ["jest", "node", "react"]
  },
  "include": [
    "src/**/*",
    "tools/**/*",
    "./jest.setup.ts",
    "index.js",
    "jest.config.ts",
    "metro.config.ci.js",
    "metro.config.js"
  ]
}
